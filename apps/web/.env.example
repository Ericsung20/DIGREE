# Copy to .env.local. Placeholder values only; never commit real keys.

# 1 = run fully on mock data (no optimizer, no database)
DIGREE_MOCK=1

# Optimizer base URL. Called server-side only, and only when DIGREE_MOCK=0.
OPTIMIZER_URL=http://localhost:8000

# Data source: "mock" (localStorage, no sign-in) or "supabase". Independent of DIGREE_MOCK.
NEXT_PUBLIC_DIGREE_DATA=mock

# Supabase. Used when NEXT_PUBLIC_DIGREE_DATA=supabase. Public URL and public anon key only; never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
